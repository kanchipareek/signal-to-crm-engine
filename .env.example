# Path to Project 1's SQLite database (the shared source of truth).
# For a demo without Project 1, run `python scripts/build_ci_db.py` and use: LEAD_DB_PATH=ci.db
LEAD_DB_PATH=

# Shared secret for HMAC-signing webhooks (any long random string; used by sender and receiver).
WEBHOOK_SECRET=

# Optional
WEBHOOK_URL=http://127.0.0.1:8000/webhook
WEBHOOK_PORT=8000
