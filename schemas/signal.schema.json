{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GTM signal event (leadership hire or money raised)",
  "type": "object",
  "required": ["event", "company_id", "source", "board_token", "external_id", "title", "detected_at"],
  "properties": {
    "event": {"type": "string", "enum": ["gtm_leadership_hire", "money_raised"]},
    "signal_id": {"type": "integer"},
    "company_id": {"type": "integer"},
    "company_name": {"type": "string"},
    "company_domain": {"type": ["string", "null"]},
    "source": {"type": "string"},
    "board_token": {"type": "string"},
    "external_id": {"type": "string"},
    "source_url": {"type": "string"},
    "title": {"type": "string"},
    "department": {"type": ["string", "null"]},
    "first_published": {"type": ["string", "null"]},
    "amount_usd": {"type": ["integer", "null"], "description": "money_raised only: total amount sold on the Form D"},
    "detected_at": {"type": "string"}
  }
}
